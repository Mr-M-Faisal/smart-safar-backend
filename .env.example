# Copy these variables into the existing Elastic Beanstalk environment:
# AWS Console > Elastic Beanstalk > your backend environment > Configuration > Updates, monitoring, and logging > Environment properties.
# Never commit a real .env file. It is already excluded via .gitignore.

# From MongoDB Atlas (Connect > Drivers). Replace <password> and the DB name.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Long random string (at least 32 characters). Keep it secret.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Access token lifetime (this is the name your code actually reads)
JWT_ACCESS_EXPIRES_IN=15m

NODE_ENV=production

# Do NOT set PORT. The hosting service supplies it.

# Your frontend origin (no trailing slash).
# Several URLs can be separated by commas.
# Use * only while testing.
CORS_ORIGIN=https://main.dzixuixoy06km.amplifyapp.com

# Number of trusted proxy hops between the client and Express. Verify using the admin diagnostic first.
TRUST_PROXY_HOPS=1

# Optional, admin-only proxy chain diagnostic. Keep false except during troubleshooting.
ENABLE_PROXY_DIAGNOSTIC=false

# Leave false in production. Only for local dev login testing.
ALLOW_LOCAL_TEST_LOGIN=false

# Optional settings (defaults are used if you skip them)
# SHIFT_STALE_HOURS=12
# SESSION_INACTIVITY_DAYS=7
# BOOKING_FARE=0
# BOOKING_CURRENCY=PKR
# PAYMENT_PROVIDER=
# PAYMENT_WEBHOOK_SECRET=
