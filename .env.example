# Copy these variables into Render:
# Dashboard > your backend service > Environment.
# Never commit a real .env file. It is already excluded via .gitignore.

# From MongoDB Atlas (Connect > Drivers). Replace <password> and the DB name.
MONGO_URI=your-mongodb-atlas-connection-string

# Long random string (at least 32 characters). Keep it secret.
JWT_SECRET=a-long-random-production-secret

# Access token lifetime (this is the name your code actually reads)
JWT_ACCESS_EXPIRES_IN=15m

NODE_ENV=production

# Do NOT set PORT. Render sets it automatically.

# Your frontend URL on Render (no trailing slash).
# Several URLs can be separated by commas.
# Use * only while testing.
CORS_ORIGIN=https://your-frontend.onrender.com

# Leave false in production. Only for local dev login testing.
ALLOW_LOCAL_TEST_LOGIN=false

# Optional settings (defaults are used if you skip them)
# SHIFT_STALE_HOURS=12
# SESSION_INACTIVITY_DAYS=7
# BOOKING_FARE=0
# BOOKING_CURRENCY=PKR
# PAYMENT_PROVIDER=
# PAYMENT_WEBHOOK_SECRET=