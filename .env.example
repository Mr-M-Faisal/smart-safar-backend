# Copy the variables below into the Elastic Beanstalk environment's
# Configuration > Software > Environment properties. Never commit a real
# .env file — it's already excluded via .gitignore.

MONGO_URI=your-mongodb-atlas-connection-string
JWT_SECRET=a-long-random-production-secret
JWT_EXPIRES_IN=7d
NODE_ENV=production

# Comma-separated list of allowed frontend origins once you have them,
# e.g. your CloudFront domain and/or Amplify domain:
# CORS_ORIGIN=https://dxxxxxxxxxxxxx.cloudfront.net,https://main.dxxxxxxxxxxxxx.amplifyapp.com
CORS_ORIGIN=*

# Leave unset (or false) in production. Only used for local dev login testing.
ALLOW_LOCAL_TEST_LOGIN=false
